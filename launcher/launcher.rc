// sc4-region-sync launcher resources. UTF-8, unlike src/version.rc.
// No winres.h: its SpecStrings.h include warns on a case-sensitive disk.
#include "version.h"

LANGUAGE 0x09, 0x01  // LANG_ENGLISH, SUBLANG_ENGLISH_US

1 24 "launcher.manifest"

1 VERSIONINFO  // VS_VERSION_INFO
 FILEVERSION RESOURCE_VERSION
 PRODUCTVERSION RESOURCE_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RaleighWorth Consulting, LLC"
            VALUE "FileDescription", "Launches and switches between SimCity 4 instances for SC4RegionSync."
            VALUE "FileVersion", RESOURCE_VERSION_STR
            VALUE "InternalName", "SC4RegionSyncLauncher.exe"
            VALUE "LegalCopyright", "Copyright (C) 2026 RaleighWorth Consulting, LLC"
            VALUE "OriginalFilename", "SC4RegionSyncLauncher.exe"
            VALUE "ProductName", "SC4RegionSync"
            VALUE "ProductVersion", RESOURCE_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
